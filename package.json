{
  "name": "ai-cut",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "main": "dist-electron/main.js",
  "description": "剧流 Studio：无限画布 + 智能体，从剧本到成片",
  "scripts": {
    "dev": "vite",
    "web": "vite --mode web",
    "build": "vue-tsc --noEmit && vite build",
    "electron:build": "vue-tsc --noEmit && vite build && node scripts/clean-unpacked.mjs && electron-builder",
    "preview": "vite preview --host",
    "type-check": "vue-tsc --noEmit"
  },
  "build": {
    "appId": "com.aicuts.desktop",
    "productName": "剧流 Studio",
    "icon": "logo.png",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "extraResources": [
      {
        "from": "logo.png",
        "to": "logo.png"
      }
    ],
    "win": {
      "icon": "logo.png",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "installerIcon": "logo.png",
      "uninstallerIcon": "logo.png",
      "installerHeaderIcon": "logo.png"
    }
  },
  "dependencies": {
    "@ffmpeg/ffmpeg": "^0.12.10",
    "@ffmpeg/util": "^0.12.1",
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/controls": "^1.1.3",
    "@vue-flow/core": "^1.48.2",
    "@vue-flow/minimap": "^1.5.4",
    "naive-ui": "^2.38.2",
    "pinia": "^2.1.7",
    "vue": "^3.4.27",
    "vue-router": "^4.3.2"
  },
  "devDependencies": {
    "@types/node": "^20.12.12",
    "@vitejs/plugin-vue": "^5.0.4",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "typescript": "^5.4.5",
    "vite": "^5.2.11",
    "vite-plugin-electron": "^1.1.1",
    "vue-tsc": "^2.0.19"
  }
}
