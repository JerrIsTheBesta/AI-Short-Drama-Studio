{
  "name": "ai-cut",
  "private": true,
  "version": "0.1.18",
  "type": "module",
  "main": "dist-electron/main.js",
  "description": "剧流 Studio：开源 AI短剧生成、AI短剧工作台与 AI video workflow studio",
  "homepage": "https://github.com/JerrIsTheBesta/AI-Short-Drama-Studio",
  "repository": {
    "type": "git",
    "url": "https://github.com/JerrIsTheBesta/AI-Short-Drama-Studio.git"
  },
  "keywords": [
    "AI短剧生成",
    "AI短剧工作台",
    "AI视频生成",
    "ai-short-drama",
    "ai-video-generator",
    "video-workflow",
    "storyboard",
    "image-to-video"
  ],
  "scripts": {
    "dev": "vite",
    "web": "vite --mode web",
    "security:check": "node scripts/assert-source-clean.mjs",
    "build": "node scripts/assert-source-clean.mjs && vue-tsc --noEmit && vite build && node scripts/assert-pack-clean.mjs",
    "electron:build": "node scripts/assert-source-clean.mjs && vue-tsc --noEmit && vite build && node scripts/assert-pack-clean.mjs && node scripts/pack-electron.mjs",
    "preview": "vite preview --host",
    "type-check": "vue-tsc --noEmit",
    "diagnose:storyboard": "node scripts/diagnose-storyboard-llm.mjs"
  },
  "build": {
    "appId": "com.aicuts.desktop",
    "productName": "剧流 Studio",
    "icon": "logo.ico",
    "directories": {
      "output": "release"
    },
    "electronDist": "node_modules/electron/dist",
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "!**/.env",
      "!**/.env.*",
      "!**/*.local"
    ],
    "extraResources": [
      {
        "from": "logo.ico",
        "to": "logo.ico"
      },
      {
        "from": "logo.png",
        "to": "logo.png"
      }
    ],
    "win": {
      "icon": "logo.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "installerIcon": "logo.ico",
      "uninstallerIcon": "logo.ico",
      "installerHeaderIcon": "logo.ico"
    }
  },
  "dependencies": {
    "@ffmpeg/ffmpeg": "^0.12.10",
    "@ffmpeg/util": "^0.12.1",
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/controls": "^1.1.3",
    "@vue-flow/core": "^1.48.2",
    "@vue-flow/minimap": "^1.5.4",
    "naive-ui": "^2.38.2",
    "pinia": "^2.1.7",
    "vue": "^3.4.27",
    "vue-router": "^4.3.2"
  },
  "devDependencies": {
    "@types/node": "^20.12.12",
    "@vitejs/plugin-vue": "^5.0.4",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "typescript": "^5.4.5",
    "vite": "^5.2.11",
    "vite-plugin-electron": "^1.1.1",
    "vue-tsc": "^2.0.19"
  }
}
