# ===== AI 服务配置（不配则走 mock 模式跑通流程） =====

# 是否使用真实 API（true / false，默认 false）
VITE_AI_REAL_MODE=false

# ---------- 主 LLM（智能体 + 分镜脚本 + 口播文案，DeepSeek） ----------
# OpenAI Chat Completions 兼容协议：POST /v1/chat/completions
# Authorization: Bearer $DEEPSEEK_API_KEY
VITE_LLM_BASE_URL=https://api.deepseek.com
VITE_LLM_API_KEY=sk-your-deepseek-key
VITE_LLM_MODEL=deepseek-v4-flash

# ---------- 视觉理解 / 多模态质检（Qwen，仅作视觉工具） ----------
# 未配置时复用下面的图像服务地址与密钥
VITE_VISION_BASE_URL=https://api.apiyi.com/v1
VITE_VISION_API_KEY=sk-your-apiyi-key
VITE_VISION_MODEL=qwen3-vl-plus

# ---------- 视频复刻（参考成片理解 + 用户产品出图） ----------
# 理解参考视频镜头：Qwen3.8-Max（不支持看图时会回退到上面的视觉模型）
VITE_REMAKE_VISION_MODEL=qwen3.8-max
# 复刻镜头出图：APIYI GPT（多图参考走 /images/edits）
VITE_REMAKE_IMAGE_MODEL=gpt-image-2

# ---------- 图像（APIYI Seedream 文生图 / 多图融合） ----------
# 统一端点：POST /v1/images/generations
#   文生图：不传 image
#   图编辑/多图融合：传 image[]（data URI 或 URL）+ sequential_image_generation=disabled
# 响应优先：data[].b64_json（纯 base64）
VITE_IMAGE_BASE_URL=https://api.apiyi.com/v1
VITE_IMAGE_API_KEY=sk-your-apiyi-key
VITE_IMAGE_MODEL=seedream-4-5-251128

# ---------- 视频（图生视频，基于 ComfyUI workflow） ----------
# 协议：提交任务 → 拿 prompt_id → 轮询结果
#   POST {BASE}/api/workflow/generate   body: {workflow_id, input_values}
#   GET  {BASE}/api/workflow/result?prompt_id=...   轮询拿视频 URL
# input_values 字段（按 workflow_id 变）：
#   137/139/141:image      3 张图（data:base64 或公网 URL）
#   92:filename_prefix     输出文件名前缀
#   92:format / 92:codec   auto
#   145:预设分辨率         "自定义"
#   145:批量大小           1
#   145:自定义宽/自定义高  自定义分辨率
#   146:prompt             文本提示词
#   147:value              帧数（≈时长 × 8）
#   154:strength_model     模型强度（0-1）
VITE_VIDEO_BASE_URL=https://uu459546-78656cd2bf79.westd.seetacloud.com:8443
VITE_VIDEO_WORKFLOW_ID=minimax_h3_light2v-1
VITE_VIDEO_API_KEY=
VITE_VIDEO_MODEL=

# ---------- 口播 TTS（阿里云百炼 SpeechSynthesizer / Qwen-Audio-TTS） ----------
# 文档：百炼实时语音合成（url=2938790）同系列；成片配音走非实时 HTTP
VITE_TTS_BASE_URL=https://dashscope.aliyuncs.com/api/v1
VITE_TTS_API_KEY=sk-your-dashscope-key
VITE_TTS_MODEL=qwen-audio-3.0-tts-flash
VITE_TTS_VOICE=longanhuan_v3.6

# ---------- 整片 BGM（MiniMax Music 3.0 纯音乐） ----------
VITE_MUSIC_BASE_URL=https://api.minimaxi.com/v1
VITE_MUSIC_API_KEY=sk-your-minimax-key
VITE_MUSIC_MODEL=music-3.0
