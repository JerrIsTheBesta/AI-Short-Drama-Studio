# ===== AI 服务配置（仅本机开发；打包不会带上这里的 Key） =====

# 是否使用真实 API（true / false，默认 false）
VITE_AI_REAL_MODE=false

# ---------- 主 LLM（智能体 + 分镜脚本，DeepSeek 官方） ----------
# OpenAI Chat Completions 兼容：POST /v1/chat/completions
VITE_LLM_BASE_URL=https://api.deepseek.com
VITE_LLM_API_KEY=sk-your-deepseek-key
VITE_LLM_MODEL=deepseek-v4-flash

# ---------- 视觉理解（阿里云百炼 Qwen-VL 官方） ----------
VITE_VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VITE_VISION_API_KEY=sk-your-dashscope-key
VITE_VISION_MODEL=qwen-vl-max

# ---------- 视频复刻 ----------
VITE_REMAKE_VISION_MODEL=qwen-vl-max
VITE_REMAKE_IMAGE_MODEL=gpt-image-1

# ---------- 图像（字节火山方舟 Seedream 官方） ----------
# POST /images/generations（OpenAI 兼容）
VITE_IMAGE_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
VITE_IMAGE_API_KEY=your-volcengine-key
VITE_IMAGE_MODEL=doubao-seedream-4-0-250828

# ---------- 视频（MiniMax 官方；节点也可选阿里万相 3.0 Prime） ----------
VITE_VIDEO_BASE_URL=https://api.minimaxi.com/v1
VITE_VIDEO_WORKFLOW_ID=
VITE_VIDEO_API_KEY=sk-your-minimax-key
VITE_VIDEO_MODEL=

# ---------- 口播 TTS（阿里云百炼官方） ----------
VITE_TTS_BASE_URL=https://dashscope.aliyuncs.com/api/v1
VITE_TTS_API_KEY=sk-your-dashscope-key
VITE_TTS_MODEL=qwen-audio-3.0-tts-flash
VITE_TTS_VOICE=longanhuan_v3.6

# ---------- 整片 BGM（MiniMax 官方） ----------
VITE_MUSIC_BASE_URL=https://api.minimaxi.com/v1
VITE_MUSIC_API_KEY=sk-your-minimax-key
VITE_MUSIC_MODEL=music-3.0
